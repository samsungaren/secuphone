<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer circle (red ring) -->
    <item>
        <shape android:shape="oval">
            <stroke android:color="@color/error_red" android:width="5dp" />
            <size android:width="170dp" android:height="170dp" />
        </shape>
    </item>
    <!-- Inner circle (dark background) -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/block" />
        </shape>
    </item>
</layer-list> 