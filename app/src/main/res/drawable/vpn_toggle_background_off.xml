<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1F2A3F" />
            <size android:width="170dp" android:height="170dp" />
            <stroke android:width="2dp" android:color="#2A3F6A" />
        </shape>
    </item>
    <!-- Inner circle -->
    <item android:left="20dp" android:top="20dp" android:right="20dp" android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#151F30" />
            <stroke android:width="1dp" android:color="#404E6A" />
        </shape>
    </item>
</layer-list> 