<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_background"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/loud_audio_signal"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_device_for_signal"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <!-- Device Selection Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#33FFFFFF"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">

        <RadioGroup
            android:id="@+id/deviceRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/thisDeviceRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/this_device"
                android:checked="true"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:buttonTint="@color/accent_primary" />

            <RadioButton
                android:id="@+id/remoteDeviceRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/paired_device"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:buttonTint="@color/accent_primary" />
        </RadioGroup>
    </androidx.cardview.widget.CardView>

    <!-- Signal Duration Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/signal_duration"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/durationSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:progress="30"
        android:max="60"
        android:progressTint="@color/audio_signal_color"
        android:thumbTint="@color/audio_signal_color" />

    <TextView
        android:id="@+id/durationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="30 seconds"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <!-- Volume Level Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/volume_level"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/volumeSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:progress="100"
        android:max="100"
        android:progressTint="@color/audio_signal_color"
        android:thumbTint="@color/audio_signal_color" />

    <TextView
        android:id="@+id/volumeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="100%"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancelButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"
            android:textColor="@color/white"
            app:strokeColor="@color/white" />

        <Button
            android:id="@+id/startSignalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/audio_signal_color"
            android:text="@string/start_signal"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout> 