<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_lock_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".AppLockActivity">

    <!-- Navbar / Toolbar (same as main activity) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/navbar_background"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_shield_logo"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/app_name"
                android:textColor="@color/logo"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/menu_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/menu" />
        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- Navbar Shadow Line -->
    <View
        android:id="@+id/navbar_shadow"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/navbar_shadow"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/navbar_shadow"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- App Selection Area -->
            <FrameLayout
                android:id="@+id/app_selection_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:background="@drawable/dashed_border_container">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/choose_apps_to_lock"
                        android:textColor="@color/text"
                        android:textSize="18sp"
                        android:gravity="center" />
                </LinearLayout>
            </FrameLayout>

            <!-- Locked Apps Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/locked_apps"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Snapchat App -->
            <LinearLayout
                android:id="@+id/snapchat_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/menu_item_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_snapchat"
                    android:contentDescription="@string/snapchat" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/snapchat"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp" />

                <ImageView
                    android:id="@+id/snapchat_lock_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock_closed"
                    android:contentDescription="@string/locked" />
            </LinearLayout>

            <!-- Facebook App -->
            <LinearLayout
                android:id="@+id/facebook_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/menu_item_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_facebook"
                    android:contentDescription="@string/facebook" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/facebook"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp" />

                <ImageView
                    android:id="@+id/facebook_lock_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock_closed"
                    android:contentDescription="@string/locked" />
            </LinearLayout>

            <!-- TikTok App -->
            <LinearLayout
                android:id="@+id/tiktok_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/menu_item_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_tiktok"
                    android:contentDescription="@string/tiktok" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tiktok"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp" />

                <ImageView
                    android:id="@+id/tiktok_lock_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock_open"
                    android:contentDescription="@string/unlocked" />
            </LinearLayout>

            <!-- WhatsApp App -->
            <LinearLayout
                android:id="@+id/whatsapp_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/menu_item_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_whatsapp"
                    android:contentDescription="@string/whatsapp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/whatsapp"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp" />

                <ImageView
                    android:id="@+id/whatsapp_lock_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock_open"
                    android:contentDescription="@string/unlocked" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout> 