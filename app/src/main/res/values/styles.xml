<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Screen Theme -->
    <style name="SplashTheme" parent="Theme.SecuPhoneByCoursor">
        <item name="android:statusBarColor">@color/navbar_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/navbar_background</item>
    </style>

    <!-- Translucent Theme for Lock Screen -->
    <style name="Theme.AppCompat.Translucent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- New Neomorphic Card Style -->
    <style name="NeomorphicCard">
        <item name="android:background">@drawable/neomorphic_ripple</item>
        <item name="android:elevation">4dp</item>
        <item name="android:padding">24dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- Card Title Text Style -->
    <style name="CardTitleText">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>

    <!-- Security Dashboard Gauge Style -->
    <style name="SecurityGauge">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/circular_progress_foreground</item>
        <item name="android:background">@drawable/circular_progress_background</item>
    </style>

    <!-- Enhanced Grid Item Style -->
    <style name="EnhancedGridItem">
        <item name="android:background">@drawable/neomorphic_ripple</item>
        <item name="android:elevation">3dp</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:minHeight">140dp</item>
    </style>

    <!-- Feature Icon Style -->
    <style name="FeatureIcon">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:padding">6dp</item>
    </style>

    <!-- Feature Title Style -->
    <style name="FeatureTitle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <!-- VPN Connection Stats Style -->
    <style name="VpnStatLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- VPN Connection Value Style -->
    <style name="VpnStatValue">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Server List Item Style -->
    <style name="ServerListItem">
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/server_card_ripple</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources> 