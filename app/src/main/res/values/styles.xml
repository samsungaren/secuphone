<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Screen Theme -->
    <style name="SplashTheme" parent="Theme.SecuPhoneByCoursor">
        <item name="android:statusBarColor">@color/navbar_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/navbar_background</item>
    </style>
    
    <!-- Translucent Theme for Lock Screen -->
    <style name="Theme.AppCompat.Translucent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources> 